# Copy this file to .env and adapt it to your environment.

# --- Active Directory / LDAP ---
# Domain controller URL (ldap://host:389 or ldaps://host:636).
# Several DCs can be listed, comma separated: they are tried in order.
LDAP_URL=ldap://dc01.example.local:389
# AD DNS domain, used as UPN suffix (user -> user@example.local)
LDAP_DOMAIN=example.local
# Search base. Optional: derived from LDAP_DOMAIN if empty (example.local -> DC=example,DC=local)
LDAP_BASE_DN=
# DN of the group allowed to administer the dashboard (nested membership is supported).
# Optional: defaults to the built-in Administrators group: CN=Administrators,CN=Builtin,<LDAP_BASE_DN>
LDAP_ADMIN_GROUP_DN=
# Use StartTLS on an ldap:// connection
LDAP_STARTTLS=false
# Verify the DC certificate for ldaps:// / StartTLS (set false only for self-signed test setups)
LDAP_TLS_REJECT_UNAUTHORIZED=true
# Optional path (inside the container) to a PEM CA certificate for the DC
LDAP_CA_CERT=

# --- Application ---
# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me
SITE_TITLE=Dashboard
# Set to true when served behind an HTTPS reverse proxy
TRUST_PROXY=false
COOKIE_SECURE=false
SESSION_MAX_AGE_MINUTES=480
MAX_UPLOAD_MB=10

# --- Optional break-glass local admin (leave empty to disable) ---
LOCAL_ADMIN_USER=
LOCAL_ADMIN_PASSWORD=
